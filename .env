# Готовый шаблон под проект rmlrctgvxzpiszqrfhzt + Render (IPv4).
# Регион возьми в Supabase: Project → Connect → Session pooler (строка URI уже с правильным aws-0-…).

DATABASE_BACKEND=postgres
NODE_ENV=production
PORT=6005

# Session pooler (IPv4, prepared statements OK для pg). НЕ direct db.*.supabase.co и НЕ :6543 transaction.
# Пользователь ОБЯЗАТЕЛЬНО: postgres.rmlrctgvxzpiszqrfhzt  (с ref после точки)
# Хост: скопируй из Connect — aws-0-… или aws-1-… (например aws-1-eu-central-1.pooler.supabase.com)
DATABASE_URL=postgresql://postgres.rmlrctgvxzpiszqrfhzt:evreiskayasila@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# TLS: для *.pooler.supabase.com по умолчанию нестрогая проверка цепочки (иначе Node: self-signed certificate in chain).
# Строгая проверка: DATABASE_SSL_STRICT=true (может снова потребоваться CA из дашборда Supabase).
# DATABASE_SSL_INSECURE=true — то же самое явно (любой хост).

JWT_SECRET=сгенерируй-длинную-случайную-строку
JWT_EXPIRES_IN=7d

# Страница /sdcs/video — встраивание YouTube (файл на сервере не нужен)
SDCS_YOUTUBE_URL=https://www.youtube.com/watch?v=CViEs3hTNfU
# или только id: SDCS_YOUTUBE_VIDEO_ID=CViEs3hTNfU

# Неверный пример для Render (только IPv6, без A-записи):
# postgresql://postgres:...@db.rmlrctgvxzpiszqrfhzt.supabase.co:5432/postgres
INTEGRATION_TRUSTED_HOSTS="console.test.greenapi.org/,console.green-api.com"